@model LoginViewModel
<div class="row justify-content-center"><div class="col-md-5"><div class="card shadow border-0"><div class="card-body p-4"><h1 class="h4 mb-3"><i class="bi bi-shield-lock"></i> Login</h1><form asp-action="Login" method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div><div class="mb-3"><label asp-for="Usuario" class="form-label"></label><input asp-for="Usuario" class="form-control" autofocus/><span asp-validation-for="Usuario" class="text-danger"></span></div><div class="mb-3"><label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control"/><span asp-validation-for="Senha" class="text-danger"></span></div><button class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Entrar</button><p class="text-muted small mt-3 mb-0">Usuário padrão: <b>admin</b> | Senha: <b>Admin@123</b></p></form></div></div></div></div>
