@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

@* WRAPPER: cobre 100% da tela, position:relative para que os filhos absolute funcionem *@
<div class="login-wrapper">

    @* Logo — position:absolute top-right *@
    <div class="login-logo">
        <span class="login-logo__name">aec</span>
        <div class="login-logo__tagline">Relacionamento com<br/>Responsabilidade</div>
    </div>

    @* Texto de boas-vindas — position:absolute bottom-left *@
    <div class="login-welcome">
        <div class="login-welcome__badge">
            <i class="bi bi-play-fill"></i> Portal de Acesso
        </div>
        <h2 class="login-welcome__title">Bem-vindo de volta!</h2>
        <p class="login-welcome__sub">
            Realize o seu login e <strong>encontre o endereço</strong> que mais combina com você.
        </p>
    </div>

    @* Card branco flutua à direita (margin-left: auto no CSS) *@
    <div class="login-card">

        <h1 class="login-title">Faça seu login</h1>
        <p class="login-subtitle">Insira seu usuário e senha abaixo para entrar na sua conta</p>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert-login-error">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>Usuário ou senha inválidos.</span>
                </div>
            }

            <div class="form-floating mb-3">
                <input asp-for="Usuario" class="form-control" placeholder="Usuário" id="Usuario" autofocus autocomplete="username" />
                <label for="Usuario">Usuário</label>
                <span asp-validation-for="Usuario" class="text-danger" style="font-size:0.8rem"></span>
            </div>

            <div class="form-floating mb-2 password-wrapper">
                <input asp-for="Senha" class="form-control pe-5" placeholder="Senha" id="Senha" autocomplete="current-password" />
                <label for="Senha">Senha<span class="text-danger ms-1">*</span></label>
                <button type="button" class="btn-toggle-eye" id="toggleSenha" aria-label="Mostrar/ocultar senha">
                    <i class="bi bi-eye" id="eyeIcon"></i>
                </button>
                <span asp-validation-for="Senha" class="text-danger" style="font-size:0.8rem"></span>
            </div>

            <div class="mb-3 mt-1">
                <a href="#" class="link-forgot">Esqueci minha senha.</a>
            </div>

            <button type="submit" class="btn-entrar mb-3">ENTRAR</button>
        </form>

        <p class="text-link-row">
            Ainda não possui cadastro? <a href="#" class="link-disabled">Cadastre-se aqui.</a>
        </p>

        <div class="divider-or">Ou continue com uma das contas abaixo</div>

        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn-social">
                <svg width="16" height="16" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M43.6 20.5H42V20.4H24v7.2h11.3C33.7 32 29.3 35.2 24 35.2c-6.2 0-11.2-5-11.2-11.2S17.8 12.8 24 12.8c2.9 0 5.5 1.1 7.5 2.9l5.1-5.1C33.5 7.6 29 5.6 24 5.6 14 5.6 5.8 13.8 5.8 23.8S14 42 24 42c9.4 0 17.4-6.8 17.4-16.6 0-1.1-.1-2.2-.3-3.2H43.6z" fill="#FFC107"/>
                    <path d="M8.3 14.8 14.3 19.2C16 14.9 19.7 12.8 24 12.8c2.9 0 5.5 1.1 7.5 2.9l5.1-5.1C33.5 7.6 29 5.6 24 5.6c-6.9 0-12.9 3.9-15.7 9.2z" fill="#FF3D00"/>
                    <path d="M24 42c4.9 0 9.3-1.9 12.6-5l-5.8-4.9C28.9 33.6 26.6 34.4 24 34.4c-5.3 0-9.7-3.2-11.3-7.7L6.7 31.2C9.5 37.4 16.2 42 24 42z" fill="#4CAF50"/>
                    <path d="M43.6 20.5H42V20.4H24v7.2h11.3c-.8 2.2-2.3 4.1-4.2 5.5l5.8 4.9C36.3 38.6 43.8 34 43.8 24c0-1.1-.1-2.2-.3-3.2H43.6z" fill="#1976D2"/>
                </svg>
                GOOGLE
            </button>
            <button type="button" class="btn-social">
                <svg width="16" height="16" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 4C13 4 4 13 4 24c0 10 7.3 18.3 16.9 19.8V30h-5v-6h5v-4.5C20.9 14.7 23.9 12 28.5 12c2.2 0 4.5.4 4.5.4V17h-2.5c-2.5 0-3.3 1.6-3.3 3.2V24h5.6l-.9 6h-4.7v13.8C36.7 42.3 44 34 44 24 44 13 35 4 24 4z" fill="#1877F2"/>
                    <path d="M31.9 30l.9-6h-5.6v-3.8c0-1.6.8-3.2 3.3-3.2H33v-4.6s-2.3-.4-4.5-.4c-4.6 0-7.6 2.7-7.6 7.5V24h-5v6h5v13.8c1 .2 2 .2 3 .2s2-.1 3-.2V30h4.9z" fill="#fff"/>
                </svg>
                FACEBOOK
            </button>
        </div>

        <p class="text-link-row">
            Não tem mais acesso? <a href="#" class="link-disabled">Recupere aqui.</a>
        </p>

        <div class="login-footer">
            <span class="login-version">Versão 1.0.1</span>
            <a href="https://wa.me/" target="_blank" class="btn-whatsapp">
                <i class="bi bi-whatsapp"></i> FALE CONOSCO
            </a>
        </div>

    </div>
</div>

@section Scripts {
<script>
    document.getElementById('toggleSenha').addEventListener('click', function () {
        const input = document.getElementById('Senha');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    });
</script>
}
