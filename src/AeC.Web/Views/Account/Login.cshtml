@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

@* Mostra o preloader apenas se acabou de se cadastrar com sucesso *@
@if (TempData.Peek("RegisterSuccess") != null)
{
    <style>
    #preloader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(140deg, #62D4EA 0%, #AEC6D2 30%, #3B9DC8 60%, #1A6AAD 100%);
      transition: opacity 0.4s ease;
    }
    #preloader::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle at 15% 50%, rgba(255,255,255,0.12) 0%, transparent 50%),
        radial-gradient(circle at 85% 30%, rgba(255,255,255,0.18) 0%, transparent 40%);
      pointer-events: none;
    }
    .preloader-headset-wrap {
      position: relative;
      width: 110px;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
    }
    .preloader-headset-icon {
      color: #ffffff;
      width: 56px;
      height: 56px;
      filter: drop-shadow(0 2px 8px rgba(0, 85, 150, 0.25));
      animation:
        headset-enter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both,
        headset-shake 2s ease-in-out 1s infinite;
      z-index: 2;
      position: relative;
    }
    @@keyframes headset-enter {
      0%   { opacity: 0; transform: scale(0.4) rotate(-15deg); }
      70%  { opacity: 1; transform: scale(1.1) rotate(4deg); }
      100% { opacity: 1; transform: scale(1) rotate(0deg); }
    }
    @@keyframes headset-shake {
      0%    { transform: rotate(0deg); }
      5%    { transform: rotate(-9deg); }
      10%   { transform: rotate(9deg); }
      15%   { transform: rotate(-6deg); }
      20%   { transform: rotate(6deg); }
      25%   { transform: rotate(0deg); }
      100%  { transform: rotate(0deg); }
    }
    .preloader-wave {
      position: absolute;
      border-radius: 50%;
      border: 2.5px solid rgba(255, 255, 255, 0.85);
      animation: sound-wave 1.6s ease-out infinite;
      inset: 0;
    }
    .preloader-wave:nth-child(1) { animation-delay: 0ms; }
    .preloader-wave:nth-child(2) { animation-delay: 280ms; }
    .preloader-wave:nth-child(3) { animation-delay: 560ms; }
    @@keyframes sound-wave {
      0%   { opacity: 0.9; transform: scale(0.5); }
      100% { opacity: 0;   transform: scale(1.35); }
    }
    .preloader-logo {
      display: flex;
      align-items: baseline;
      gap: 2px;
      font-family: 'Inter', sans-serif;
      font-size: 2.4rem;
      font-weight: 900;
      letter-spacing: -1px;
      margin-bottom: 8px;
    }
    .preloader-logo span {
      display: inline-block;
      opacity: 0;
      animation: letter-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .preloader-logo .pl-a { color: #ffffff;    animation-delay: 400ms; }
    .preloader-logo .pl-e { color: #d0f0fb;    animation-delay: 520ms; }
    .preloader-logo .pl-c { color: #ffffff;    animation-delay: 640ms; }
    @@keyframes letter-pop {
      0%   { opacity: 0; transform: translateY(12px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .preloader-tagline {
      font-family: 'Inter', sans-serif;
      font-size: 0.82rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.8);
      letter-spacing: 0.04em;
      margin: 0;
      opacity: 0;
      animation: letter-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) 760ms forwards;
    }
    .preloader-progress-track {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: rgba(255,255,255,0.2);
      overflow: hidden;
    }
    .preloader-progress-fill {
      height: 100%;
      width: 0%;
      background: rgba(255,255,255,0.85);
      animation: progress-fill 900ms cubic-bezier(0.4, 0, 0.2, 1) 150ms forwards;
    }
    @@keyframes progress-fill {
      from { width: 0%; }
      to   { width: 100%; }
    }
    </style>

    <div id="preloader" role="status" aria-label="Carregando...">
        <div class="preloader-headset-wrap">
            <div class="preloader-wave"></div>
            <div class="preloader-wave"></div>
            <div class="preloader-wave"></div>
            <svg class="preloader-headset-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/>
                <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
            </svg>
        </div>
        <div class="preloader-logo" aria-hidden="true">
            <span class="pl-a">a</span><span class="pl-e">e</span><span class="pl-c">c</span>
        </div>
        <p class="preloader-tagline">Conectando você...</p>
        <div class="preloader-progress-track">
            <div class="preloader-progress-fill"></div>
        </div>
    </div>
    
    <script>
      (function () {
        var MIN_MS = 600;
        var start = Date.now();
        window.addEventListener('load', function () {
          var elapsed = Date.now() - start;
          var delay = Math.max(0, MIN_MS - elapsed);
          setTimeout(function () {
            var el = document.getElementById('preloader');
            if (el) {
              el.style.opacity = '0';
              setTimeout(function () { el.remove(); }, 400);
            }
          }, delay);
        });
      })();
    </script>
}
@* WRAPPER: cobre 100% da tela, position:relative para que os filhos absolute funcionem *@
<div class="login-wrapper">

    @* Logo — position:absolute top-right *@
    <div class="login-logo">
        <span class="login-logo__name"><span class="logo-blue-dark">a</span><span class="logo-blue-light">e</span><span class="logo-blue-dark">c</span></span>
        <div class="login-logo__tagline">Relacionamento com<br/>Responsabilidade</div>
    </div>

    @* Texto de boas-vindas — position:absolute bottom-left *@
    <div class="login-welcome">
        <div class="login-welcome__badge">
            <i class="bi bi-play-fill"></i> Portal de Acesso
        </div>
        <h2 class="login-welcome__title">Bem-vindo de volta!</h2>
        <p class="login-welcome__sub">
            Realize o seu login e <strong>encontre o endereço</strong> que mais combina com você.
        </p>
    </div>

    @* Card branco flutua à direita (margin-left: auto no CSS) *@
    <div class="login-card">

        <h1 class="login-title">Faça seu login</h1>
        <p class="login-subtitle">Insira seu usuário e senha abaixo para entrar na sua conta</p>

        <!-- Informação do Usuário Padrão de forma discreta -->
        <div class="alert alert-info py-2 px-3 mb-3 border-0" style="background-color: #f0f7fb; border-radius: 8px; font-size: 0.8rem; color: #3b88b0;">
            <i class="bi bi-info-circle-fill me-1"></i>
            Usuário padrão: <strong>admin</strong> | Senha: <strong>Admin@123</strong>
        </div>

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            @Html.AntiForgeryToken()

            @* Mensagens de erro serão exibidas via Toastr *@

            <div class="form-floating mb-3">
                <input asp-for="Usuario" class="form-control" placeholder="Usuário" id="Usuario" autofocus autocomplete="username" />
                <label for="Usuario">Usuário</label>
                <span asp-validation-for="Usuario" class="text-danger" style="font-size:0.8rem"></span>
            </div>

            <div class="form-floating mb-2 password-wrapper">
                <input asp-for="Senha" class="form-control pe-5" placeholder="Senha" id="Senha" autocomplete="current-password" />
                <label for="Senha">Senha<span class="text-danger ms-1">*</span></label>
                <button type="button" class="btn-toggle-eye" id="toggleSenha" aria-label="Mostrar/ocultar senha">
                    <i class="bi bi-eye" id="eyeIcon"></i>
                </button>
                <span asp-validation-for="Senha" class="text-danger" style="font-size:0.8rem"></span>
            </div>

            <div class="mb-3 mt-1">
                <a href="#" class="link-forgot">Esqueci minha senha.</a>
            </div>

            <button type="submit" class="btn-entrar mb-3">ENTRAR</button>
        </form>

        <p class="text-link-row">
            Ainda não possui cadastro? <a asp-action="Register" asp-controller="Account" class="fw-semibold" style="color:#3b9dc8; text-decoration:none;">Cadastre-se aqui.</a>
        </p>

        <div class="divider-or">Ou continue com uma das contas abaixo</div>

        <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn-social">
                <svg width="16" height="16" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M43.6 20.5H42V20.4H24v7.2h11.3C33.7 32 29.3 35.2 24 35.2c-6.2 0-11.2-5-11.2-11.2S17.8 12.8 24 12.8c2.9 0 5.5 1.1 7.5 2.9l5.1-5.1C33.5 7.6 29 5.6 24 5.6 14 5.6 5.8 13.8 5.8 23.8S14 42 24 42c9.4 0 17.4-6.8 17.4-16.6 0-1.1-.1-2.2-.3-3.2H43.6z" fill="#FFC107"/>
                    <path d="M8.3 14.8 14.3 19.2C16 14.9 19.7 12.8 24 12.8c2.9 0 5.5 1.1 7.5 2.9l5.1-5.1C33.5 7.6 29 5.6 24 5.6c-6.9 0-12.9 3.9-15.7 9.2z" fill="#FF3D00"/>
                    <path d="M24 42c4.9 0 9.3-1.9 12.6-5l-5.8-4.9C28.9 33.6 26.6 34.4 24 34.4c-5.3 0-9.7-3.2-11.3-7.7L6.7 31.2C9.5 37.4 16.2 42 24 42z" fill="#4CAF50"/>
                    <path d="M43.6 20.5H42V20.4H24v7.2h11.3c-.8 2.2-2.3 4.1-4.2 5.5l5.8 4.9C36.3 38.6 43.8 34 43.8 24c0-1.1-.1-2.2-.3-3.2H43.6z" fill="#1976D2"/>
                </svg>
                GOOGLE
            </button>
            <button type="button" class="btn-social">
                <svg width="16" height="16" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 4C13 4 4 13 4 24c0 10 7.3 18.3 16.9 19.8V30h-5v-6h5v-4.5C20.9 14.7 23.9 12 28.5 12c2.2 0 4.5.4 4.5.4V17h-2.5c-2.5 0-3.3 1.6-3.3 3.2V24h5.6l-.9 6h-4.7v13.8C36.7 42.3 44 34 44 24 44 13 35 4 24 4z" fill="#1877F2"/>
                    <path d="M31.9 30l.9-6h-5.6v-3.8c0-1.6.8-3.2 3.3-3.2H33v-4.6s-2.3-.4-4.5-.4c-4.6 0-7.6 2.7-7.6 7.5V24h-5v6h5v13.8c1 .2 2 .2 3 .2s2-.1 3-.2V30h4.9z" fill="#fff"/>
                </svg>
                FACEBOOK
            </button>
        </div>

        <p class="text-link-row">
            Não tem mais acesso? <a href="#" class="link-disabled">Recupere aqui.</a>
        </p>

        <div class="login-footer">
            <span class="login-version">Versão 1.1.0</span>
            <a href="https://wa.me/" target="_blank" class="btn-whatsapp">
                <i class="bi bi-whatsapp"></i> FALE CONOSCO
            </a>
        </div>

    </div>
</div>

@section Scripts {
<script>
    document.getElementById('toggleSenha').addEventListener('click', function () {
        const input = document.getElementById('Senha');
        const icon  = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    });

    // Configuração do Toastr
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "5000",
        "extendedTimeOut": "1000"
    };

    // Dispara erro se a validação do Model falhar
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        @:toastr.error("Usuário ou senha inválidos.", "Falha no Login");
    }

    // Exibe mensagem de sucesso após cadastro
    @if (TempData["RegisterSuccess"] is string successMsg)
    {
        @:toastr.success(@Html.Raw(Json.Serialize(successMsg)), "Conta Criada!");
    }
</script>
}
