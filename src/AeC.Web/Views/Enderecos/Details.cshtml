@model EnderecoDto
<div class="card shadow-sm"><div class="card-body"><h1 class="h4">Detalhes</h1><dl class="row"><dt class="col-sm-3">CEP</dt><dd class="col-sm-9">@Model.CEP</dd><dt class="col-sm-3">Logradouro</dt><dd class="col-sm-9">@Model.Logradouro, @Model.Numero</dd><dt class="col-sm-3">Complemento</dt><dd class="col-sm-9">@Model.Complemento</dd><dt class="col-sm-3">Bairro</dt><dd class="col-sm-9">@Model.Bairro</dd><dt class="col-sm-3">Cidade/UF</dt><dd class="col-sm-9">@Model.Cidade/@Model.UF</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div></div>
