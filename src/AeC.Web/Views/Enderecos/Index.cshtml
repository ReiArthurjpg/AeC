@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ── Tooltips ──────────────────────────────────────────────────────────
    [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        .forEach(el => new bootstrap.Tooltip(el));

    // ── Helpers ───────────────────────────────────────────────────────────
    function setupCepMask(input, loadingId, btnId, fields) {
        if (!input) return;
        input.addEventListener('input', () => {
            let v = input.value.replace(/\D/g, '').slice(0, 8);
            input.value = v.length > 5 ? v.slice(0, 5) + '-' + v.slice(5) : v;
        });
        const buscar = async () => {
            const clean = input.value.replace(/\D/g, '');
            if (clean.length !== 8) return;
            const load = document.getElementById(loadingId);
            if (load) load.classList.remove('d-none');
            try {
                const resp = await fetch(`/Enderecos/BuscarCep?cep=${clean}`);
                if (!resp.ok) { Swal.fire('CEP não encontrado', 'Verifique o CEP informado.', 'info'); return; }
                const d = await resp.json();
                if (fields.logradouro) document.getElementById(fields.logradouro).value = d.logradouro || '';
                if (fields.complemento) document.getElementById(fields.complemento).value = d.complemento || '';
                if (fields.bairro) document.getElementById(fields.bairro).value = d.bairro || '';
                if (fields.cidade) document.getElementById(fields.cidade).value = d.localidade || '';
                if (fields.uf) document.getElementById(fields.uf).value = d.uf || '';
            } catch { Swal.fire('Falha na consulta', 'Não foi possível consultar o ViaCEP agora.', 'error'); }
            finally { if (load) load.classList.add('d-none'); }
        };
        input.addEventListener('blur', buscar);
        const btn = document.getElementById(btnId);
        if (btn) btn.addEventListener('click', buscar);
    }

    function clearErrors(formEl, summaryId) {
        document.getElementById(summaryId)?.classList.add('d-none');
        formEl.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
        formEl.querySelectorAll('.invalid-feedback').forEach(el => el.textContent = '');
    }

    function showErrors(errors, prefix, summaryId, summaryTextId) {
        let hasError = false;
        for (const [field, msgs] of Object.entries(errors)) {
            const input = document.getElementById(prefix + field);
            if (input) input.classList.add('is-invalid');
            const errEl = document.getElementById(prefix.replace('-','err-') + field);
            if (errEl && msgs.length) errEl.textContent = msgs[0];
            hasError = true;
        }
        if (hasError) {
            document.getElementById(summaryId)?.classList.remove('d-none');
            const txt = document.getElementById(summaryTextId);
            if (txt) txt.textContent = 'Por favor, corrija os erros destacados.';
        }
    }

    async function ajaxSave(url, data, btn, textEl, spinnerEl) {
        btn.disabled = true;
        const orig = textEl.textContent;
        textEl.textContent = 'Salvando...';
        spinnerEl.classList.remove('d-none');
        try {
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: data
            });
            return await resp.json();
        } finally {
            btn.disabled = false;
            textEl.textContent = orig;
            spinnerEl.classList.add('d-none');
        }
    }

    function successAndReload(modalEl, message) {
        bootstrap.Modal.getInstance(modalEl).hide();
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });
        Toast.fire({ icon: 'success', title: message })
            .then(() => window.location.reload());
    }

    // ── Re-render Lucide on any modal open ────────────────────────────────
    document.querySelectorAll('.modal').forEach(m =>
        m.addEventListener('shown.bs.modal', () => lucide.createIcons())
    );

    // ═══════════════════════════════════════════════════════════════════════
    // MODAL: NOVO ENDEREÇO
    // ═══════════════════════════════════════════════════════════════════════
    const modalNovo = document.getElementById('modalNovoEndereco');
    const formNovo = document.getElementById('form-novo-endereco');

    modalNovo.addEventListener('hidden.bs.modal', () => { formNovo.reset(); clearErrors(formNovo, 'modal-novo-validation'); lucide.createIcons(); });

    setupCepMask(
        document.querySelector('.cep-mask-novo'), 'cep-loading-novo', 'btn-buscar-cep-novo',
        { logradouro: 'n-Logradouro', complemento: 'n-Complemento', bairro: 'n-Bairro', cidade: 'n-Cidade', uf: 'n-UF' }
    );

    document.getElementById('btn-salvar-novo').addEventListener('click', async () => {
        clearErrors(formNovo, 'modal-novo-validation');
        const token = formNovo.querySelector('input[name="__RequestVerificationToken"]').value;
        const data = new URLSearchParams({
            __RequestVerificationToken: token,
            CEP: document.getElementById('n-CEP').value,
            Logradouro: document.getElementById('n-Logradouro').value,
            Numero: document.getElementById('n-Numero').value,
            Complemento: document.getElementById('n-Complemento').value,
            Bairro: document.getElementById('n-Bairro').value,
            Cidade: document.getElementById('n-Cidade').value,
            UF: document.getElementById('n-UF').value,
        });
        try {
            const result = await ajaxSave('/Enderecos/Create', data,
                document.getElementById('btn-salvar-novo'),
                document.getElementById('btn-salvar-novo-text'),
                document.getElementById('btn-salvar-novo-spinner'));
            if (result.success) {
                successAndReload(modalNovo, 'Endereço cadastrado!');
            } else {
                showErrors(result.errors || {}, 'n-', 'modal-novo-validation', 'modal-novo-validation-text');
            }
        } catch { Swal.fire('Erro', 'Não foi possível salvar. Tente novamente.', 'error'); }
    });

    // ═══════════════════════════════════════════════════════════════════════
    // MODAL: VISUALIZAR ENDEREÇO
    // ═══════════════════════════════════════════════════════════════════════
    const modalVer = document.getElementById('modalVerEndereco');
    let currentViewId = null;

    document.querySelectorAll('.btn-ver-endereco').forEach(btn => {
        btn.addEventListener('click', async () => {
            currentViewId = btn.dataset.id;
            const body = document.getElementById('modal-ver-body');
            body.innerHTML = '<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>';
            new bootstrap.Modal(modalVer).show();
            try {
                const resp = await fetch(`/Enderecos/GetJson?id=${currentViewId}`);
                if (!resp.ok) throw new Error();
                const e = await resp.json();
                body.innerHTML = `
                <div class="row g-3">
                    <div class="col-md-4">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">CEP</p>
                        <p class="fw-bold fs-5 mb-0">${e.cep || '—'}</p>
                    </div>
                    <div class="col-md-5">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">Logradouro</p>
                        <p class="fw-medium mb-0">${e.logradouro || '—'}</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">Número</p>
                        <p class="fw-medium mb-0">${e.numero || '—'}</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">Complemento</p>
                        <p class="fw-medium mb-0">${e.complemento || '—'}</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">Bairro</p>
                        <p class="fw-medium mb-0">${e.bairro || '—'}</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted fw-semibold mb-1" style="font-size:12px;text-transform:uppercase;letter-spacing:.5px">Cidade / UF</p>
                        <span class="badge fs-6 fw-semibold" style="background:rgba(98,212,234,.15);color:#1A6AAD;">${e.cidade || '—'} / ${e.uf || '—'}</span>
                    </div>
                </div>`;
            } catch {
                body.innerHTML = '<p class="text-danger text-center">Não foi possível carregar os dados.</p>';
            }
        });
    });

    // Botão "Editar" dentro do modal de visualização
    document.getElementById('btn-ver-para-editar').addEventListener('click', () => {
        bootstrap.Modal.getInstance(modalVer).hide();
        setTimeout(() => abrirModalEditar(currentViewId), 400);
    });

    // ═══════════════════════════════════════════════════════════════════════
    // MODAL: EDITAR ENDEREÇO
    // ═══════════════════════════════════════════════════════════════════════
    const modalEditar = document.getElementById('modalEditarEndereco');
    const formEditar = document.getElementById('form-editar-endereco');

    modalEditar.addEventListener('hidden.bs.modal', () => { formEditar.reset(); clearErrors(formEditar, 'modal-editar-validation'); lucide.createIcons(); });

    setupCepMask(
        document.querySelector('.cep-mask-editar'), 'cep-loading-editar', 'btn-buscar-cep-editar',
        { logradouro: 'e-Logradouro', complemento: 'e-Complemento', bairro: 'e-Bairro', cidade: 'e-Cidade', uf: 'e-UF' }
    );

    async function abrirModalEditar(id) {
        document.getElementById('e-Id').value = id;
        try {
            const resp = await fetch(`/Enderecos/GetJson?id=${id}`);
            if (!resp.ok) throw new Error();
            const e = await resp.json();
            document.getElementById('e-CEP').value = e.cep || '';
            document.getElementById('e-Logradouro').value = e.logradouro || '';
            document.getElementById('e-Numero').value = e.numero || '';
            document.getElementById('e-Complemento').value = e.complemento || '';
            document.getElementById('e-Bairro').value = e.bairro || '';
            document.getElementById('e-Cidade').value = e.cidade || '';
            document.getElementById('e-UF').value = e.uf || '';
        } catch { Swal.fire('Erro', 'Não foi possível carregar os dados.', 'error'); return; }
        new bootstrap.Modal(modalEditar).show();
    }

    document.querySelectorAll('.btn-editar-endereco').forEach(btn => {
        btn.addEventListener('click', () => abrirModalEditar(btn.dataset.id));
    });

    document.getElementById('btn-salvar-editar').addEventListener('click', async () => {
        clearErrors(formEditar, 'modal-editar-validation');
        const id = document.getElementById('e-Id').value;
        const token = formEditar.querySelector('input[name="__RequestVerificationToken"]').value;
        const data = new URLSearchParams({
            __RequestVerificationToken: token,
            Id: id,
            CEP: document.getElementById('e-CEP').value,
            Logradouro: document.getElementById('e-Logradouro').value,
            Numero: document.getElementById('e-Numero').value,
            Complemento: document.getElementById('e-Complemento').value,
            Bairro: document.getElementById('e-Bairro').value,
            Cidade: document.getElementById('e-Cidade').value,
            UF: document.getElementById('e-UF').value,
        });
        try {
            const result = await ajaxSave(`/Enderecos/Edit/${id}`, data,
                document.getElementById('btn-salvar-editar'),
                document.getElementById('btn-salvar-editar-text'),
                document.getElementById('btn-salvar-editar-spinner'));
            if (result.success) {
                successAndReload(modalEditar, 'Endereço atualizado!');
            } else {
                showErrors(result.errors || {}, 'e-', 'modal-editar-validation', 'modal-editar-validation-text');
            }
        } catch { Swal.fire('Erro', 'Não foi possível salvar. Tente novamente.', 'error'); }
    });

    // ── Delete confirm ────────────────────────────────────────────────────
    document.querySelectorAll('.delete-form').forEach(form => {
        const btn = form.querySelector('button.delete');
        btn.addEventListener('click', e => {
            e.preventDefault();
            Swal.fire({
                title: 'Excluir endereço?',
                text: 'Esta ação não poderá ser desfeita.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="swal-icon-btn"></i> Sim, excluir',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                reverseButtons: true,
                focusCancel: true,
                customClass: {
                    popup: 'swal-aec-popup',
                    title: 'swal-aec-title',
                }
            }).then(result => {
                if (result.isConfirmed) {
                    skipNextPreloader(); form.submit();
                }
            });
        });
    });
});

// ── View Mode Toggle ────────────────────────────────────────────────────
function setViewMode(mode) {
    const listBtn = document.getElementById('btn-view-list');
    const cardBtn = document.getElementById('btn-view-card');
    const listView = document.getElementById('view-list');
    const cardView = document.getElementById('view-card');

    if (!listBtn || !cardBtn || !listView || !cardView) return;

    // Reset animation
    listView.classList.remove('view-mode-enter');
    cardView.classList.remove('view-mode-enter');
    // Force DOM reflow to restart animation
    void listView.offsetWidth;
    void cardView.offsetWidth;

    if (mode === 'card') {
        listBtn.classList.remove('active');
        cardBtn.classList.add('active');
        listView.classList.add('d-none');
        cardView.classList.remove('d-none');
        cardView.classList.add('view-mode-enter');
    } else {
        cardBtn.classList.remove('active');
        listBtn.classList.add('active');
        cardView.classList.add('d-none');
        listView.classList.remove('d-none');
        listView.classList.add('view-mode-enter');
    }
    localStorage.setItem('aec_address_view_mode', mode);
}

// Initialize view mode on load
(function() {
    const savedMode = localStorage.getItem('aec_address_view_mode') || 'list';
    document.addEventListener('DOMContentLoaded', () => {
        setViewMode(savedMode);
        
        // Setup Search Debounce
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            // Restore focus to end of text after reload
            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
            
            let debounceTimer;
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    skipNextPreloader(); this.form.submit();
                }, 500);
            });
        }

        // Paginação: suprimir preloader ao navegar entre páginas
        document.querySelectorAll('.pagination a, [data-pager]').forEach(function(a) {
            a.addEventListener('click', function() { skipNextPreloader(); });
        });
    });
})();
</script>
}
