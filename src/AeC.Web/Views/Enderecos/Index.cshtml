    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-aec">
            <div class="modal-header modal-aec-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-header-icon"><i data-lucide="pencil"></i></div>
