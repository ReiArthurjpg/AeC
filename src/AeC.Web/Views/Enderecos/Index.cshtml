@model EnderecoListViewModel
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-0">Dashboard de Endereços</h1><span class="text-muted">Gerencie seus endereços com segurança.</span></div><div><a class="btn btn-success" asp-action="ExportCsv"><i class="bi bi-filetype-csv"></i> Exportar CSV</a> <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-circle"></i> Novo</a></div></div><form class="card card-body mb-3"><div class="row g-2"><div class="col-md-7"><input name="termo" value="@Model.Termo" class="form-control" placeholder="Pesquisar por CEP ou cidade"/></div><div class="col-md-3"><select name="ordenarPor" class="form-select"><option value="cidade">Cidade A-Z</option><option value="cidade_desc">Cidade Z-A</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Buscar</button></div></div></form><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>CEP</th><th>Logradouro</th><th>Cidade/UF</th><th>Número</th><th class="text-end">Ações</th></tr></thead><tbody>@foreach(var e in Model.Enderecos.Items){<tr><td>@e.CEP</td><td>@e.Logradouro</td><td>@e.Cidade/@e.UF</td><td>@e.Numero</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id"><i class="bi bi-eye"></i></a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id"><i class="bi bi-pencil"></i></a> <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline delete-form">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr>}@if(!Model.Enderecos.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum endereço encontrado.</td></tr>}</tbody></table></div></div>
