@model EnderecoListViewModel

<div class="row mb-4 align-items-center">
    <div class="col-lg-6 mb-3 mb-lg-0">
        <h1 class="h3 fw-bold mb-1 text-dark">Olá, @(User.Identity?.Name ?? "Administrador") 👋</h1>
        <p class="text-muted mb-0">Gerencie seus endereços de maneira rápida e segura.</p>
    </div>
    <div class="col-lg-6">
        <div class="d-flex gap-3 justify-content-lg-end">
            <div class="stat-card">
                <div class="stat-icon"><i data-lucide="map-pin"></i></div>
                <div class="stat-content">
                    <h4>@Model.Enderecos.Total</h4>
                    <p>Total de Endereços</p>
                </div>
            </div>
            <div class="stat-card d-none d-sm-flex">
                <div class="stat-icon"><i data-lucide="building-2"></i></div>
                <div class="stat-content">
                    <h4>@Model.TotalCidades</h4>
                    <p>Cidades cadastradas</p>
                </div>
            </div>
            <div class="stat-card d-none d-md-flex">
                <div class="stat-icon"><i data-lucide="clock"></i></div>
                <div class="stat-content">
                    <h4>@DateTime.Now.ToString("HH:mm")</h4>
                    <p>Última atualização</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card p-4 mb-4">
    <form method="get">
        <div class="row g-2 mb-2">
            <div class="col-xl-8 col-lg-7 col-md-12">
                <div class="position-relative">
                    <i data-lucide="search" class="position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary" style="width:18px;height:18px;"></i>
                    <input id="searchInput" name="termo" value="@Model.Termo" class="form-control ps-5" placeholder="Pesquisar por CEP, Rua ou Cidade..." aria-label="Pesquisar">
                </div>
            </div>
            <div class="col-xl-4 col-lg-5 col-md-12 d-flex justify-content-xl-end justify-content-start gap-2 align-items-center">
                <!-- View Toggle Buttons -->
                <div class="btn-group" role="group" aria-label="Modo de visualização">
                    <button type="button" class="btn btn-outline-secondary active" id="btn-view-list" onclick="setViewMode('list')">
                        <i data-lucide="list"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btn-view-card" onclick="setViewMode('card')">
                        <i data-lucide="layout-grid"></i>
                    </button>
                </div>
                
                <a class="btn btn-outline-secondary d-none d-sm-inline-flex align-items-center" asp-action="ExportCsv">
                    <i data-lucide="download" class="me-1"></i> Exportar
                </a>
                <button class="btn btn-primary d-inline-flex align-items-center" type="button" data-bs-toggle="modal" data-bs-target="#modalNovoEndereco">
                    <i data-lucide="plus" class="me-1"></i> Novo
                </button>
            </div>
        </div>
        <div class="row g-2">
            <div class="col-xl-3 col-lg-4 col-md-6">
                <select name="uf" class="form-select" onchange="skipNextPreloader(); this.form.submit()">
                    <option value="">UF (Todos)</option>
                    @foreach(var uf in Model.UfsDisponiveis)
                    {
                        <option value="@uf" selected="@(Model.UF == uf)">@uf</option>
                    }
                </select>
            </div>
            <div class="col-xl-3 col-lg-4 col-md-6">
                <select name="ordenarPor" class="form-select" aria-label="Ordenar" onchange="skipNextPreloader(); this.form.submit()">
                    @if(Model.OrdenarPor == "cidade_desc") {
                        <option value="cidade">Cidade A-Z</option>
                        <option value="cidade_desc" selected>Cidade Z-A</option>
                    } else {
                        <option value="cidade" selected>Cidade A-Z</option>
                        <option value="cidade_desc">Cidade Z-A</option>
                    }
                </select>
            </div>
        </div>
    </form>
</div>

<div class="border-0 bg-transparent" id="container-enderecos">
    @if(Model.Enderecos.Items.Any()){
        <div id="view-list" class="card overflow-hidden view-mode">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">CEP</th>
                            <th>Logradouro</th>
                            <th>Cidade/UF</th>
                            <th>Número</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach(var e in Model.Enderecos.Items){
                        <tr>
                            <td class="ps-4 fw-medium">@e.CEP</td>
                            <td>@e.Logradouro</td>
                            <td><span class="badge bg-light text-dark border">@e.Cidade / @e.UF</span></td>
                            <td>@e.Numero</td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <button class="btn-icon btn-ver-endereco" title="Visualizar" data-bs-toggle="tooltip" data-id="@e.Id">
                                        <i data-lucide="eye"></i>
                                    </button>
                                    <button class="btn-icon btn-editar-endereco" title="Editar" data-bs-toggle="tooltip" data-id="@e.Id">
                                        <i data-lucide="pencil"></i>
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn-icon delete" title="Excluir">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="view-card" class="view-mode d-none">
            <div class="row g-3">
                @foreach(var e in Model.Enderecos.Items){
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
                        <div class="card h-100 shadow-sm border-0 address-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0">@e.CEP</h5>
                                    <span class="badge bg-light text-dark border">@e.UF</span>
                                </div>
                                <p class="card-text text-muted mb-1 text-truncate" title="@e.Logradouro, @e.Numero">@e.Logradouro, @e.Numero</p>
                                <p class="card-text text-muted mb-3"><i data-lucide="map-pin" style="width:14px;height:14px;" class="me-1"></i>@e.Cidade</p>
                                <div class="d-flex justify-content-end gap-1 border-top pt-3">
                                    <button class="btn btn-outline-secondary btn-sm btn-ver-endereco" title="Visualizar" data-id="@e.Id"><i data-lucide="eye" style="width:16px;height:16px;"></i></button>
                                    <button class="btn btn-outline-primary btn-sm btn-editar-endereco" title="Editar" data-id="@e.Id"><i data-lucide="pencil" style="width:16px;height:16px;"></i></button>
                                    <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-outline-danger btn-sm delete" title="Excluir"><i data-lucide="trash-2" style="width:16px;height:16px;"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    } else {
        <div class="card overflow-hidden">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i data-lucide="map-pinned" style="width:40px;height:40px;"></i>
                </div>
                <h3 class="empty-state-title">Nenhum endereço encontrado</h3>
                <p class="empty-state-desc">Você ainda não cadastrou nenhum endereço ou a sua busca não retornou resultados.</p>
                <button class="btn btn-primary px-4" type="button" data-bs-toggle="modal" data-bs-target="#modalNovoEndereco">
                    <i data-lucide="plus"></i> Novo Endereço
                </button>
            </div>
        </div>
    }
</div>

@if(Model.Enderecos.TotalPages > 1)
{
    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
        <p class="mb-0 text-muted small">
            Mostrando <strong>@(((Model.Enderecos.Page - 1) * Model.Enderecos.PageSize) + 1)</strong>–<strong>@Math.Min(Model.Enderecos.Page * Model.Enderecos.PageSize, Model.Enderecos.Total)</strong> de <strong>@Model.Enderecos.Total</strong> endereços
        </p>
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0 gap-1">
                @* Anterior *@
                <li class="page-item @(!Model.Enderecos.HasPrevious ? "disabled" : "")">
                    <a class="page-link rounded-3" 
                       href="?pagina=@(Model.Enderecos.Page - 1)&termo=@Model.Termo&ordenarPor=@Model.OrdenarPor&uf=@Model.UF&cidade=@Model.Cidade"
                       aria-label="Página anterior">
                        <i data-lucide="chevron-left" style="width:16px;height:16px;"></i>
                    </a>
                </li>

                @* Números de página *@
                @for(int i = 1; i <= Model.Enderecos.TotalPages; i++)
                {
                    @* Mostrar apenas páginas próximas à atual para não poluir *@
                    @if(i == 1 || i == Model.Enderecos.TotalPages || (i >= Model.Enderecos.Page - 2 && i <= Model.Enderecos.Page + 2))
                    {
                        <li class="page-item @(i == Model.Enderecos.Page ? "active" : "")">
                            <a class="page-link rounded-3" 
                               href="?pagina=@i&termo=@Model.Termo&ordenarPor=@Model.OrdenarPor&uf=@Model.UF&cidade=@Model.Cidade">@i</a>
                        </li>
                    }
                    else if(i == Model.Enderecos.Page - 3 || i == Model.Enderecos.Page + 3)
                    {
                        <li class="page-item disabled"><span class="page-link rounded-3">…</span></li>
                    }
                }

                @* Próxima *@
                <li class="page-item @(!Model.Enderecos.HasNext ? "disabled" : "")">
                    <a class="page-link rounded-3" 
                       href="?pagina=@(Model.Enderecos.Page + 1)&termo=@Model.Termo&ordenarPor=@Model.OrdenarPor&uf=@Model.UF&cidade=@Model.Cidade"
                       aria-label="Próxima página">
                        <i data-lucide="chevron-right" style="width:16px;height:16px;"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}

@* ===== MODAL: NOVO ENDEREÇO ===== *@
<div class="modal fade" id="modalNovoEndereco" tabindex="-1" aria-labelledby="modalNovoEnderecoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-aec">
            <div class="modal-header modal-aec-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="modal-header-icon"><i data-lucide="map-pin"></i></div>
                    <div>
                        <h5 class="modal-title mb-0" id="modalNovoEnderecoLabel">Novo Endereço</h5>
                        <p class="modal-subtitle mb-0">Preencha os dados do endereço abaixo</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="form-novo-endereco" novalidate>
                    @Html.AntiForgeryToken()
                    <div id="modal-novo-validation" class="alert alert-danger d-none" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i data-lucide="circle-x" style="width:18px;height:18px;flex-shrink:0;"></i>
                            <span id="modal-novo-validation-text">Corrija os erros abaixo.</span>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="n-CEP">CEP <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" id="n-CEP" name="CEP" class="form-control cep-mask-novo" placeholder="00000-000" maxlength="9" required>
                                <button class="btn btn-outline-secondary" type="button" id="btn-buscar-cep-novo">
                                    <i data-lucide="search" style="width:16px;height:16px;"></i>
                                </button>
                                <span id="cep-loading-novo" class="input-group-text d-none">
                                    <span class="spinner-border spinner-border-sm text-primary"></span>
                                </span>
                            </div>
                            <div class="invalid-feedback" id="nerr-CEP"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="n-Logradouro">Logradouro <span class="text-danger">*</span></label>
                            <input type="text" id="n-Logradouro" name="Logradouro" class="form-control" placeholder="Rua, Avenida..." required>
                            <div class="invalid-feedback" id="nerr-Logradouro"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold" for="n-Numero">Número <span class="text-danger">*</span></label>
                            <input type="text" id="n-Numero" name="Numero" class="form-control" placeholder="100" required>
                            <div class="invalid-feedback" id="nerr-Numero"></div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="n-Complemento">Complemento</label>
                            <input type="text" id="n-Complemento" name="Complemento" class="form-control" placeholder="Apto, Bloco...">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="n-Bairro">Bairro</label>
                            <input type="text" id="n-Bairro" name="Bairro" class="form-control" placeholder="Nome do bairro">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold" for="n-Cidade">Cidade <span class="text-danger">*</span></label>
                            <input type="text" id="n-Cidade" name="Cidade" class="form-control" placeholder="Cidade" required>
                            <div class="invalid-feedback" id="nerr-Cidade"></div>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label fw-semibold" for="n-UF">UF <span class="text-danger">*</span></label>
                            <input type="text" id="n-UF" name="UF" class="form-control text-uppercase" placeholder="SP" maxlength="2" required>
                            <div class="invalid-feedback" id="nerr-UF"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-aec-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i data-lucide="x"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btn-salvar-novo">
                    <i data-lucide="save"></i>
                    <span id="btn-salvar-novo-text">Salvar Endereço</span>
                    <span id="btn-salvar-novo-spinner" class="spinner-border spinner-border-sm d-none ms-1"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@* ===== MODAL: VISUALIZAR ENDEREÇO ===== *@
